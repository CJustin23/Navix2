# Copy this file to .env.local (gitignored, matched by the `*.local` rule)
# and fill in the values from your Supabase project settings
# (Project Settings → API).
#
# Both variables are safe to expose to the browser — the anon key only
# grants what Row Level Security in supabase/migrations/0001_init.sql
# allows. Never put the service_role key here; that one belongs only in
# Vercel's server-side env vars, read by the /api/* functions.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
